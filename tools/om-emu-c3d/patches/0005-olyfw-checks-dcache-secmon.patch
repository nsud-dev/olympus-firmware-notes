index 0000000..bb9fd33
--- /dev/null
+++ b/emu/src/core/secmon.mjs
@@ -0,0 +1,33 @@
+// Optional section first-touch monitor (olyfw patch 0005; MIT, see om-emu's LICENSE).
+//
+// On the camera block0's ten sections become usable one after another while the boot goes on, and until section n is
+// finalised a hardware access monitor covers [start of section n .. end of section 10]; om-emu has every section in
+// place from the reset (emu/FIDELITY-NOTES.md 7.18) and does not run the start-up stages. Stock code never touches a
+// section before it is ready, so in a stock run the first touch of each section is a lower bound for when the camera
+// has it ready. This monitor records, per section, the first instruction fetches and data accesses into it (instruction
+// clock t, pc, address). Compare a build's run with stock's (tools: private notes): a
+// touch of section n before stock's first touch is a boot-order risk the lab cannot show by itself.
+//
+// Enabled through src/core/olyfw.mjs (host/olyfwenv.mjs: OM_SECMON=FILE). Windows come from the image's section table.
+export function createSectionMonitor({ windows, insns, pc, keep = 48 }) {
+  const first = windows.map(() => []);
+  let t = 0;                                       // events seen (loads, stores, first decodes): the run's clock here
+  const n = windows.length;
+  const which = (a) => { for (let i = 0; i < n; i++) if (a >= windows[i][0] && a < windows[i][1]) return i; return -1; };
+  const fromSec = (p) => which(p >>> 0) + 1;     // 0: outside every section (always-ready code, stubs)
+  const blocks = new Map();                        // 256-byte block -> its first touch {t, kind, pc}
+  function note(kind, a) {
+    const i = which(a >>> 0);
+    if (i >= 0 && !blocks.has(a >>> 8)) blocks.set(a >>> 8, [t, kind, pc() >>> 0]);
+    if (i < 0 || first[i].length >= keep) return;
+    const p = pc() >>> 0;
+    if (kind !== 'f' && which(p) === i) return;   // a section's own code touching its own data says nothing
+    first[i].push({ t, insns: insns(), kind, pc: '0x' + p.toString(16), from_section: fromSec(p), addr: '0x' + (a >>> 0).toString(16) });
+  }
+  return {
+    fetch(p) { t++; note('f', p); },
+    ld(a) { t++; note('r', ((a >>> 0) & 0x1fffffff) | 0x60000000); },
+    st(a) { t++; note('w', ((a >>> 0) & 0x1fffffff) | 0x60000000); },
+    summary() { return { blocks: Object.fromEntries([...blocks].map(([b, [tt, k, p]]) => ['0x' + (b << 8 >>> 0).toString(16), [tt, k, '0x' + p.toString(16)]])), windows: windows.map(([lo, hi], i) => ({ section: i + 1, lo: '0x' + lo.toString(16), hi: '0x' + hi.toString(16), first: first[i] })) }; },
+  };
+}
