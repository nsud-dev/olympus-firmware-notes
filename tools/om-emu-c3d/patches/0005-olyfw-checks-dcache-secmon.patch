new file mode 100644
index 0000000..00d0498
--- /dev/null
+++ b/emu/host/olyfwenv.mjs
@@ -0,0 +1,19 @@
+// olyfw patches 0005/0006 (MIT, see om-emu's LICENSE): turn the optional checks on from the environment.
+// usage: OM_DCACHE=report[:KIB[:WAYS]] [OM_DCACHE_ALL=1] OM_DCACHE_OUT=FILE OM_SECMON=FILE OM_HEAP_FILL=HEXWORD \
+//        node --import ./host/olyfwenv.mjs bin/session.mjs ...
+// Writes the cache model's reports (OM_DCACHE_OUT) and the section monitor's record (OM_SECMON) as JSON at exit.
+import { writeFileSync } from 'node:fs';
+import { OLYFW } from '../src/core/olyfw.mjs';
+
+const env = process.env;
+if (env.OM_DCACHE) {
+  const [mode, kib, ways] = env.OM_DCACHE.split(':');
+  if (mode !== 'report') throw new Error(`OM_DCACHE: only 'report' is implemented, not '${mode}'`);
+  OLYFW.dcache = { sizeKiB: Number(kib || 8), ways: Number(ways || 2), all: env.OM_DCACHE_ALL === '1' };
+}
+if (env.OM_SECMON) OLYFW.secmon = true;
+if (env.OM_HEAP_FILL) OLYFW.heapFill = parseInt(env.OM_HEAP_FILL, 16) >>> 0;
+process.on('exit', () => {
+  if (env.OM_DCACHE_OUT && OLYFW.made.dcache) writeFileSync(env.OM_DCACHE_OUT, JSON.stringify(OLYFW.made.dcache.summary(), null, 1));
+  if (env.OM_SECMON && OLYFW.made.secmon) writeFileSync(env.OM_SECMON, JSON.stringify(OLYFW.made.secmon.summary(), null, 1));
+});
diff --git a/emu/src/core/dcache.mjs b/emu/src/core/dcache.mjs
new file mode 100644
index 0000000..2e138d7
--- /dev/null
+++ b/emu/src/core/dcache.mjs
@@ -0,0 +1,132 @@
+// Optional data-cache coherence model for CPU 0 (olyfw patch 0005; MIT, see om-emu's LICENSE).
+//
+// om-emu maps the cached DRAM view (0x6xxxxxxx) and the uncached view (0xAxxxxxxx) onto the same bytes and has no
+// cache (emu/FIDELITY-NOTES.md 4.1), so code that mixes the two views runs clean in the lab and can fail on the camera.
+// This model keeps a copy of what a write-back, write-allocate, set-associative data cache would hold, next to the
+// lab's memory, and reports where the camera would see different bytes than the lab. It does not change what the
+// program reads (report mode): the run goes on exactly as without it.
+//
+// Reports (kind):
+//   stale-read      a cached load hits a line whose copy differs from memory (memory was changed through the
+//                   uncached view or by a device since the line was filled): the camera reads the old bytes
+//   lost-write      a dirty line leaves the cache (eviction or flush) while memory under its dirty bytes was changed
+//                   through the uncached view or by a device: the camera's write-back undoes that change
+//   uncached-stale  an uncached load of bytes that a cached store changed and that are still only in the cache:
+//                   the camera reads the bytes from before that store
+// The cache flush the lab answers (K-CFLUSH) writes back and invalidates every line (the E-M5 III's routine
+// 0x600644ae does that for the whole cache).
+//
+// Enabled through src/core/olyfw.mjs (host/olyfwenv.mjs: OM_DCACHE=report[:SIZE_KIB[:WAYS]], default 8 KiB, 2 ways,
+// 16-byte lines: the E-M5 III's flush routine cleans 2 x 1024 words and clears two tag arrays in 16-byte lines).
+// By default only bytes a CPU store through the uncached view changed are reported (all: also devices and stand-ins,
+// which the lab writes directly and which the camera's firmware covers with its own cache maintenance).
+// Cached view: virtual 0x60000000-0x7fffffff; uncached view: 0xa0000000-0xdfffffff; nothing else is modelled.
+
+const LINE = 16;
+
+export function createDataCache({ sizeKiB = 8, ways = 2, all = false, U8, pc, insns, max = 400 }) {
+  const lines = (sizeKiB * 1024) / LINE, sets = lines / ways;
+  if (!Number.isInteger(sets) || sets < 1) throw new Error(`OM_DCACHE: ${sizeKiB} KiB / ${ways} ways is not a whole number of sets`);
+  const tag = new Int32Array(lines).fill(-1);          // physical line number (offset >> 4) per slot
+  const dirty = new Uint16Array(lines);                // byte mask of cached stores not written back
+  const data = new Uint8Array(lines * LINE);           // what the cache holds
+  const base = new Uint8Array(lines * LINE);           // what memory held when the line was filled or written back
+  const age = new Float64Array(lines);                 // LRU stamp
+  const unc = new Uint16Array(lines);                  // byte mask of CPU uncached stores into the line since its fill
+  const ALL = all;                                     // also report changes made by devices and lab stand-ins
+  const lastUnc = new Map();                           // physical line -> {pc, insns} of the last uncached/device change seen
+  let clock = 0;
+  const counts = { 'stale-read': 0, 'lost-write': 0, 'uncached-stale': 0, fills: 0, evictions: 0, flushes: 0, cachedLoads: 0, uncachedStores: 0 };
+  const reports = [], seen = new Set();
+  const h8 = (x) => '0x' + (x >>> 0).toString(16).padStart(8, '0');
+  const hex = (u) => Array.from(u, (b) => b.toString(16).padStart(2, '0')).join('');
+
+  function report(kind, a, o, slot, extra) {
+    counts[kind]++;
+    const key = kind + ':' + (pc() >>> 0) + ':' + (o >>> 4);
+    if (seen.has(key) || reports.length >= max) return;
+    seen.add(key);
+    const l = tag[slot], s = slot * LINE, m = l * LINE;
+    const w = lastUnc.get(l);
+    reports.push({ kind, pc: h8(pc()), insns: insns(), addr: h8(a), line_phys: h8(l * LINE),
+      cache: hex(data.subarray(s, s + LINE)), memory: hex(U8.subarray(m, m + LINE)),
+      last_uncached_change: w ? { pc: h8(w.pc), insns: w.insns } : null, ...extra });
+  }
+  function find(l) {
+    const s0 = (l % sets) * ways;
+    for (let i = s0; i < s0 + ways; i++) if (tag[i] === l) return i;
+    return -1;
+  }
+  function writeBackCheck(slot, why) {
+    const d = dirty[slot];
+    if (d === 0) return;
+    const s = slot * LINE, m = tag[slot] * LINE;
+    for (let b = 0; b < LINE; b++) {
+      if ((d & (1 << b)) && (ALL || (unc[slot] & (1 << b))) && U8[m + b] !== base[s + b] && U8[m + b] !== data[s + b]) {
+        report('lost-write', 0x60000000 + 0, m + b, slot, { why, byte: b });   // addr unknown (eviction): physical given
+        break;
+      }
+    }
+  }
+  function fill(l) {
+    const s0 = (l % sets) * ways;
+    let v = s0;
+    for (let i = s0; i < s0 + ways; i++) { if (tag[i] === -1) { v = i; break; } if (age[i] < age[v]) v = i; }
+    if (tag[v] !== -1) { counts.evictions++; writeBackCheck(v, 'eviction'); lastUnc.delete(tag[v]); }
+    tag[v] = l; dirty[v] = 0; unc[v] = 0; counts.fills++;
+    data.set(U8.subarray(l * LINE, l * LINE + LINE), v * LINE);
+    base.set(U8.subarray(l * LINE, l * LINE + LINE), v * LINE);
+    return v;
+  }
+  const cachedView = (a) => a >= 0x60000000 && a < 0x80000000;
+  const uncachedView = (a) => a >= 0xa0000000 && a < 0xe0000000;
+
+  return {
+    counts, reports, sets, ways, sizeKiB,
+    // before the load reads memory (o: physical offset)
+    ld(a, o, w) {
+      if (cachedView(a)) {
+        counts.cachedLoads++;
+        const l = o >>> 4;
+        let slot = find(l);
+        if (slot < 0) slot = fill(l);
+        else {
+          const s = slot * LINE + (o & 15);
+          for (let b = 0; b < w; b++) if (data[s + b] !== U8[o + b] && (ALL || (unc[slot] & (1 << ((o & 15) + b))))) { report('stale-read', a, o, slot, { size: w }); break; }
+          // the lab goes on with memory's bytes: resynchronise the clean bytes so one change reports once
+          for (let b = 0; b < LINE; b++) if (!(dirty[slot] & (1 << b))) { data[slot * LINE + b] = U8[l * LINE + b]; base[slot * LINE + b] = U8[l * LINE + b]; }
+          unc[slot] &= dirty[slot];
+        }
+        age[slot] = ++clock;
+      } else if (uncachedView(a)) {
+        const slot = find(o >>> 4);
+        if (slot >= 0 && dirty[slot]) {
+          const s = slot * LINE + (o & 15);
+          for (let b = 0; b < w; b++) if ((dirty[slot] & (1 << ((o & 15) + b))) && base[s + b] !== U8[o + b]) { report('uncached-stale', a, o, slot, { size: w }); break; }
+        }
+      }
+    },
+    // before the store writes memory (v: the value stored, w bytes little-endian)
+    st(a, o, w, v) {
+      const l = o >>> 4;
+      if (cachedView(a)) {
+        let slot = find(l);
+        if (slot < 0) slot = fill(l);                     // write-allocate: the line comes in with memory's old bytes
+        const s = slot * LINE + (o & 15);
+        for (let b = 0; b < w; b++) { data[s + b] = (v >>> (8 * b)) & 0xff; dirty[slot] |= 1 << ((o & 15) + b); }
+        age[slot] = ++clock;
+      } else if (uncachedView(a)) {
+        counts.uncachedStores++;
+        const slot = find(l);
+        if (slot >= 0) { lastUnc.set(l, { pc: pc(), insns: insns() }); for (let b = 0; b < w; b++) unc[slot] |= 1 << ((o & 15) + b); }
+      }
+    },
+    // the whole cache written back and invalidated (K-CFLUSH)
+    flush() {
+      counts.flushes++;
+      for (let i = 0; i < tag.length; i++) if (tag[i] !== -1) { writeBackCheck(i, 'flush'); tag[i] = -1; dirty[i] = 0; unc[i] = 0; }
+      lastUnc.clear();
+    },
+    summary() { return { model: `${sizeKiB} KiB, ${ways}-way, ${LINE}-byte lines, write-back, write-allocate`, counts, reports }; },
+  };
+}
