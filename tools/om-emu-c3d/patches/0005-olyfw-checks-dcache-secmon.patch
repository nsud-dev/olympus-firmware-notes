+// olyfw patches 0005/0006 (MIT, see om-emu's LICENSE): settings for the optional checks, set by the host before a
+// machine is made (host/olyfwenv.mjs reads them from the environment); every default leaves the lab unchanged.
+//   dcache   null, or {sizeKiB, ways, all}: the data-cache coherence model (src/core/dcache.mjs)
+//   secmon   false, or true: the section first-touch monitor (src/core/secmon.mjs)
+//   heapFill null, or a 32-bit word: S-HEAP fills each block it hands out or takes back with it (src/lab/play.mjs)
+//   made     the newest machine's model and monitor, for the host to report
+export const OLYFW = { dcache: null, secmon: false, heapFill: null, made: { dcache: null, secmon: null } };
diff --git a/emu/src/core/secmon.mjs b/emu/src/core/secmon.mjs
