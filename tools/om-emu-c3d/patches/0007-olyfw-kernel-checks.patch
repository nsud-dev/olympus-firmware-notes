diff --git a/emu/src/lab/kcheck.mjs b/emu/src/lab/kcheck.mjs
new file mode 100644
index 0000000..d0a818d
--- /dev/null
+++ b/emu/src/lab/kcheck.mjs
@@ -0,0 +1,50 @@
+// Optional kernel checks (olyfw patch 0007; MIT, see om-emu's LICENSE), for faults the camera shows and the lab hides.
+//
+// blocking-in-interrupt  a blocking service (twai_sem, wai_flg, twai_flg, loc_mtx, dly_tsk, trcv_dtq, tsnd_dtq) entered
+//                        while the running CPU is outside a task's context (the KCB +28 nesting byte is not 0, as
+//                        in_interrupt sets it): the firmware answers E_CTX, and code that then goes on as if it had
+//                        waited or holds a lock it never got fails on the camera (Live ND E2k, a lock taken in a
+//                        completion callback, 2026-10-29).
+// cross-cpu-object       the kernel's object lookup (E137 sub_60030e9d, the load at 0x60030eff of the owner CPU's
+//                        table pointer *(0x8ff00004 + 4 * cpu), cpu = id bits 12-14) on an object of another CPU. The
+//                        lab writes every CPU's pointer at boot (kernel.mjs boot), so such a lookup cannot fault here;
+//                        on the camera it faults while that CPU's kernel is not up (0x60030f01, the Live ND power-on
+//                        reset, 2026-11-22). Reported with the caller, to compare a build's sites with stock's.
+// Enabled through src/core/olyfw.mjs (host/olyfwenv.mjs: OM_KCHECK=FILE); installed when the native kernel boots.
+import { R, D0, A0, SP, MDR } from '../core/cpu.mjs';
+import { S } from '../core/cpu.mjs';
+
+const h8 = (x) => '0x' + (x >>> 0).toString(16).padStart(8, '0');
+
+export function createKernelChecks({ svc, kcb, read8, read32, lookupPc = null, max = 200 }) {
+  const counts = { 'blocking-in-interrupt': 0, 'cross-cpu-object': 0, blocking_calls: 0, lookups: 0 };
+  const reports = [], sites = new Map();
+  const ctx = () => read8(read32(kcb + 28)) !== 0;
+  const caller = () => ({ mdr: h8(R[MDR]), sp_word: h8(read32(R[SP] >>> 0)) });
+  const probes = new Map();
+  for (const name of ['twai_sem', 'wai_flg', 'twai_flg', 'loc_mtx', 'dly_tsk', 'trcv_dtq', 'tsnd_dtq']) {
+    if (svc[name] === undefined) continue;
+    probes.set(svc[name] >>> 0, () => {
+      counts.blocking_calls++;
+      if (!ctx()) return;
+      counts['blocking-in-interrupt']++;
+      if (reports.length < max) reports.push({ kind: 'blocking-in-interrupt', svc: name, insns: S.insns, d0: h8(R[D0]), ...caller() });
+    });
+  }
+  if (lookupPc !== null) {
+    probes.set(lookupPc >>> 0, () => {
+      counts.lookups++;
+      const own = read32(0x8050), cpu = (R[D0 + 2] >>> 2) & 7;        // d2 = cpu << 2 here
+      if (cpu === own) return;
+      counts['cross-cpu-object']++;
+      const c = caller(), id = R[D0] & 0xffff, key = `${cpu}:${c.sp_word}`;
+      const s = sites.get(key);
+      if (s) { s.n++; return; }
+      sites.set(key, { cpu, own, id: h8(id), first_insns: S.insns, n: 1, ...c, a2: h8(R[A0 + 2]) });
+    });
+  }
+  return {
+    probes, counts,
+    summary() { return { counts, reports, cross_cpu_sites: [...sites.values()] }; },
+  };
+}
