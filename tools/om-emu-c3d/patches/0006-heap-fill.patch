+// olyfw patch 0006: S-HEAP's optional fill (src/core/olyfw.mjs heapFill, e.g. 0xdeadbeef: odd and outside every map, so
+// a pointer or code address read from a field nobody set faults at once); one 1 MiB pattern, blocks past it partly
+let heapFillBuf = null, heapFillWord = null;
+const heapFill = () => {
+  if (OLYFW.heapFill === null) return null;
+  if (heapFillWord !== OLYFW.heapFill) {
+    const w = heapFillWord = OLYFW.heapFill; heapFillBuf = new Uint8Array(1 << 20);
+    for (let k = 0; k < heapFillBuf.length; k += 4) { heapFillBuf[k] = w & 0xff; heapFillBuf[k + 1] = (w >>> 8) & 0xff; heapFillBuf[k + 2] = (w >>> 16) & 0xff; heapFillBuf[k + 3] = w >>> 24; }
+  }
+  return heapFillBuf;
+};
 
