diff --git a/emu/src/core/sertap.mjs b/emu/src/core/sertap.mjs
new file mode 100644
index 0000000..f36c5a9
--- /dev/null
+++ b/emu/src/core/sertap.mjs
@@ -0,0 +1,51 @@
+// Optional serial-bus tap (olyfw patch 0011; MIT, see om-emu's LICENSE).
+//
+// Logs every transfer and receive the firmware starts through its serial controller driver (PER_SIO's driver, the
+// starts src/fw/facts.mjs sioDriver finds, fact 'sio' tx_start/rx_start), for every channel, whether the lab serves
+// that channel (src/lab/sio.mjs S-SIOIIC) or not. Nothing about the transfer changes: the tap only reads the
+// registers and the bytes at the start's entry.
+//
+// Why: a driver grafted from another body can run every instruction stock runs and still send the wrong bytes. A
+// test build with an expander driver grafted from another body (2026-11-23) sent a buffer nothing had filled at
+// every expander transfer, because one helper was mapped to the wrong body's routine; the chip never answered, USB
+// was dead and the Wi-Fi start reset the camera. om-emu has no expander chip, but the bytes handed to the driver show
+// the fault at the first transfer (it sent 00 00 01 where the OM-5's own run sends 1c 08 1d). The FAIL rule here: a
+// transfer whose first byte, the IIC address byte, is 0x00 (the general-call address, which none of the camera's
+// device drivers use). Comparing a build's transfers with a stock run's is the host's job (summary().transfers).
+//
+// Each start, at its entry (d0 the controller index, a0 the bytes, d1 their count, a1 the mode; the receive start:
+// a0 the buffer, a1 the count, d1 the transfer's length; mdr the caller's return address):
+// {kind: 'tx'|'rx', n, insns, index, count, mode, caller, buf, bytes (hex, up to 64), addr (the first byte)}.
+//
+// Enabled through src/core/olyfw.mjs (host/olyfwenv.mjs: OM_SERTAP=FILE writes summary() as JSON at exit).
+const h8 = (x) => '0x' + (x >>> 0).toString(16).padStart(8, '0');
+const hex = (b) => Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
+
+export function createSerialTap({ tx, rx = null, regs, read, insns, keep = 400, maxBytes = 64 }) {
+  const transfers = [], counts = { tx: 0, rx: 0, no_addr: 0 }, bad = [];
+  function at(kind) {
+    const r = regs();
+    const index = r.d0 & 0xff, buf = r.a0 >>> 0;
+    const count = (kind === 'tx' ? r.d1 : r.a1) >>> 0, mode = kind === 'tx' ? r.a1 >>> 0 : r.d1 >>> 0;
+    counts[kind]++;
+    const bytes = kind === 'tx' ? read(buf, Math.min(count, maxBytes)) : null;
+    const e = { kind, n: counts.tx + counts.rx, insns: insns(), index, count, mode, caller: h8(r.mdr), buf: h8(buf) };
+    if (bytes) { e.bytes = hex(bytes); e.addr = bytes.length ? bytes[0] : null; }
+    if (kind === 'tx' && count > 0 && bytes && bytes.length && bytes[0] === 0) {
+      counts.no_addr++;
+      if (bad.length < 32) bad.push(e);
+    }
+    if (transfers.length < keep) transfers.push(e);
+  }
+  const probes = new Map([[tx >>> 0, () => at('tx')]]);
+  if (rx !== null) probes.set(rx >>> 0, () => at('rx'));
+  return {
+    probes, counts,
+    summary() {
+      const byIndex = {};
+      for (const t of transfers) if (t.kind === 'tx') (byIndex[t.index] ??= { first: t.bytes, caller: t.caller, n: 0 }).n++;
+      return { starts: { tx: h8(tx), rx: rx === null ? null : h8(rx) }, counts, verdict: counts.no_addr ? 'FAIL' : 'PASS',
+        rule: 'a transfer whose IIC address byte is 0x00 FAILs', bad, by_index: byIndex, transfers };
+    },
+  };
+}
