diff --git a/emu/src/core/codewrite.mjs b/emu/src/core/codewrite.mjs
new file mode 100644
index 0000000..e22cab3
--- /dev/null
+++ b/emu/src/core/codewrite.mjs
@@ -0,0 +1,53 @@
+// Optional code-write monitor (olyfw patch 0010; MIT, see om-emu's LICENSE).
+//
+// The camera resets when a CPU writes program code in RAM through the cached view (memory protection; OMKit, which
+// patches code on the OM-5 II, writes it only through the uncached view, KB reference/gotchas-technical.md) [camera on
+// OM-5 II]. om-emu has no such protection, so a build that keeps data inside code runs clean here (one of our test
+// builds, 2026-11-23: a driver kept its state in a 0xFF gap of the code and the camera showed a black screen).
+//
+// What is watched: the always-loaded code of the run-time image, from the image base to the first section's start
+// (read from the image's section table after "BCS\0"; E137 1.7: 0x60021020..0x600de000, E148 1.1: ..0x600eb000).
+// Stock E137 never writes there (boot, MENU, shots, play: 0 writes, 2026-11-23). Every CPU store there is recorded:
+// 'fail' through the cached view (0x6...), 'warn' through the uncached view (0xa...). Stores into the ten sections are
+// counted per 4 KB page and listed, not judged (sections hold data stock writes: section 2 0x6034d000..0x60376000,
+// section 10 0x6145b000 on E137), so a build's list can be compared with stock's.
+//
+// Enabled through src/core/olyfw.mjs (host/olyfwenv.mjs: OM_CODEWRITE=FILE writes summary() as JSON at exit).
+const h8 = (x) => '0x' + (x >>> 0).toString(16).padStart(8, '0');
+
+// the section table after "BCS\0" in the run-time image: rows [start, flash, flags], ten of them; null if not found
+export function sectionStarts(img, base) {
+  for (let i = img.indexOf(0x42); i >= 0 && i + 4 + 120 <= img.length; i = img.indexOf(0x42, i + 1)) {
+    if (img[i + 1] !== 0x43 || img[i + 2] !== 0x53 || img[i + 3] !== 0) continue;
+    const u32 = (o) => (img[o] | img[o + 1] << 8 | img[o + 2] << 16 | img[o + 3] << 24) >>> 0, rows = [];
+    for (let k = 0; k < 10; k++) rows.push(u32(i + 4 + 12 * k));
+    if (rows.every((v, k) => v > base && (k === 0 || v > rows[k - 1]) && v < base + img.length + 0x2000000)) return rows;
+  }
+  return null;
+}
+
+export function createCodeWriteMonitor({ lo, hi, secHi = hi, pc, insns, keep = 64 }) {
+  const counts = { fail: 0, warn: 0, section: 0 };
+  const hits = [], seen = new Set(), pages = new Map();
+  function st(a, w) {
+    const v = a >>> 0, c = ((v & 0x1fffffff) | 0x60000000) >>> 0;
+    if (c >= lo && c < hi) {
+      const kind = v >= 0xa0000000 && v < 0xc0000000 ? 'warn' : 'fail';
+      counts[kind]++;
+      const p = pc() >>> 0, key = `${kind}:${c >>> 4}:${p}`;
+      if (hits.length < keep && !seen.has(key)) { seen.add(key); hits.push({ kind, addr: h8(v), width: w, pc: h8(p), insns: insns() }); }
+    } else if (c >= hi && c < secHi) {
+      counts.section++;
+      const pg = c >>> 12, e = pages.get(pg);
+      if (e) e.n++; else pages.set(pg, { n: 1, first: h8(v), pc: h8(pc()) });
+    }
+  }
+  return {
+    ld() {},
+    st(a, o, w) { st(a, w); },
+    summary() {
+      return { range: [h8(lo), h8(hi)], counts, verdict: counts.fail ? 'FAIL' : counts.warn ? 'WARN' : 'PASS', hits,
+        section_pages: [...pages].sort((x, y) => x[0] - y[0]).map(([pg, e]) => ({ page: h8(pg << 12), ...e })) };
+    },
+  };
+}
