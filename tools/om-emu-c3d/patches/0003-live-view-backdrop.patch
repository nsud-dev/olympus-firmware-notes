 import { UsageError, intValue } from '../checks/lib/args.mjs';
+// c3d-layer patch (2026-11-21): OM_BACKDROP = a 720 x 480 raw RGB file shown under every plane in place of live view
+// (src/dev/vsccompose2.mjs reads globalThis.__omBackdrop; RGB -> YCbCr by the firmware's integer BT.601)
+if (process.env.OM_BACKDROP) {
+  const b = fs.readFileSync(process.env.OM_BACKDROP), w = 720, h = 480, ycc = new Uint32Array(w * h);
+  if (b.length !== w * h * 3) throw new Error(`OM_BACKDROP: ${b.length} bytes, not 720 x 480 RGB`);
+  for (let i = 0; i < w * h; i++) {
+    const r = b[3 * i], g = b[3 * i + 1], bl = b[3 * i + 2];
+    ycc[i] = ((((r << 15) - 27440 * g - 5328 * bl) >> 16) + 128 & 0xFF) << 16 | ((((-11056 * r - 21712 * g + (bl << 15)) >> 16) + 128) & 0xFF) << 8
+      | ((19595 * r + 38470 * g + 7471 * bl) >> 16) & 0xFF;
+  }
+  globalThis.__omBackdrop = { w, h, ycc };
+}
 
 export const PRESS_MS = 150, HOLD_MS = 2000, SETTLE_MS = 600, DIAL_MAX = 8, READ_MAX = 0x10000;
 export const HITS_PER_STEP = 100;      // a record's hits: the first this many, the rest counted (hits_dropped)
